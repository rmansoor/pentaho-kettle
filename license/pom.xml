<?xml version="1.0"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <groupId>pentaho-kettle</groupId>
  <artifactId>kettle-license</artifactId>
  <version>10.1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>PDI License</name>
  <description>
    Offline-verifiable license key support: encode/decode/verify a signed license key
    (no network access, no server lookup) and a small local store for the installed key.
    See docs/licensing/DESIGN.md for the full design.
  </description>

  <parent>
    <groupId>org.pentaho.di</groupId>
    <artifactId>pdi</artifactId>
    <version>10.1.0.0-SNAPSHOT</version>
  </parent>

  <properties>
    <maven-surefire-plugin.reuseForks>true</maven-surefire-plugin.reuseForks>
  </properties>

  <dependencies>
    <dependency>
      <groupId>pentaho-kettle</groupId>
      <artifactId>kettle-core</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- test -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
