<?xml version="1.0" encoding="UTF-8"?>
<project xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd" xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.pentaho.di.plugins</groupId>
    <artifactId>pdi-plugins</artifactId>
    <version>11.1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>kafka</artifactId>
  <version>11.1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>PDI Kafka Plugin</name>
  <description>This plugin is for Pentaho Data Integration (ETL) a.k.a Kettle</description>

  <modules>
    <module>core</module>
    <module>assemblies</module>
  </modules>
  <properties>
    <pdi.version>11.1.0.0-SNAPSHOT</pdi.version>
    <dependency.hamcrest.revision>1.3</dependency.hamcrest.revision>
    <mockito-core.version>5.17.0</mockito-core.version>
  </properties>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
      <comments>A business-friendly OSS license</comments>
    </license>
  </licenses>

  <build>
    <plugins>
      <!--
        The CE parent pom binds the failsafe integration-test goal to every module, including the
        pom-packaged aggregators (kafka, kafka-assemblies, pentaho-streaming-kafka-plugin). When the
        reactor is run with -DrunITs together with -Dit.test=..., failsafe treats the absence of a
        matching test in those pom modules as a fatal error ("No tests were executed!"). Relaxing
        these two flags lets the reactor build run the real ITs in the core module while the modules
        that legitimately have no integration tests pass instead of failing the whole build.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <failIfNoTests>false</failIfNoTests>
          <failIfNoSpecifiedTests>false</failIfNoSpecifiedTests>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
